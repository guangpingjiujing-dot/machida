# ============================================================
# .env.example — このファイルをコピーして .env を作成する
#   cp .env.example .env
# .env は .gitignore で除外済み。絶対にコミットしないこと。
# ============================================================

# ----- Airflow -----
# Fernet Key: 接続情報(パスワード等)の暗号化に使用する
# 生成コマンド: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# Airflow 管理者アカウント (本番では強力なパスワードに変更すること)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-in-production

# ----- Postgres -----
# 本番では airflow/airflow から変更すること
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=airflow